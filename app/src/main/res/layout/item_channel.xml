<?xml version="1.0" encoding="utf-8"?>
<!--
  频道列表项布局
  完全依赖 Android 系统原生焦点导航

  【焦点与点击机制修正】
  - 根布局必须有 focusable="true"，才可被遥控器方向键选中
  - 根布局的 background 使用 @drawable/item_bg_selector，自动切换透明/浅蓝背景
  - 子 View（序号、名称）设为 focusable="false"，确保焦点仅停留在根布局
  - ListView 的点击事件依然由 onItemClickListener 处理，根布局不拦截点击
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="15dp"
    android:focusable="true" 
    android:clickable="true"
    android:background="@drawable/item_bg_selector">

    <!-- ============================================================ -->
    <!-- 序号（灰色背景固定，文字颜色随焦点态自动变蓝）               -->
    <!-- ============================================================ -->
    <TextView
        android:id="@+id/tv_index"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/item_text_selector"
        android:background="#333333"
        android:focusable="false"
        android:clickable="false" />

    <!-- ============================================================ -->
    <!-- 频道名称（文字颜色随焦点/选中态自动变化）                    -->
    <!-- ============================================================ -->
    <TextView
        android:id="@+id/tv_channel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:textColor="@color/item_text_selector"
        android:textSize="16sp"
        android:focusable="false"
        android:clickable="false" />

</LinearLayout>
