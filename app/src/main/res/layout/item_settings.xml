<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/item_bg_selector"
    android:focusable="true"
    android:clickable="true"> <!-- 🔥 改成 true，触屏点击按下去瞬间变色 -->
    <!-- 
      ✏️【修改点详解】
      1. clickable: 改回 "true"，保证手机触屏按下时能触发 state_pressed，立刻出高亮
      2. 由于内部 Button 自身已经 clickable="true"，点击事件依然可以正常向上冒泡给 ListView
    -->

    <TextView
        android:id="@+id/tv_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/item_text_selector"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tv_setting_item"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="middle"
        android:textColor="@color/item_text_selector"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/btn_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="删除"
        android:textSize="12sp"
        android:focusable="false"
        android:clickable="true"/>
</LinearLayout>
