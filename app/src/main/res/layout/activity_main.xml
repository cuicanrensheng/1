<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 主播放器视图 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:use_controller="false"
        app:resize_mode="fit"
        app:keep_content_on_player_reset="true"
        app:surface_type="surface_view" />

    <!-- 全局遮罩层 -->
    <ImageView
        android:id="@+id/iv_mask_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@android:color/black"
        android:alpha="0.0"
        android:visibility="gone"
        android:scaleType="fitXY" />

    <!-- 频道号显示 -->
    <TextView
        android:id="@+id/tv_channel_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:text="1"
        android:textSize="50sp"
        android:textColor="#FFF"
        android:alpha="0.8"
        android:visibility="gone" />

    <!-- 频道面板容器 -->
    <FrameLayout
        android:id="@+id/panel_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- 左侧面板 -->
        <LinearLayout
            android:id="@+id/ll_left_panel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@drawable/panel_bg"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- 分组列表 -->
            <ListView
                android:id="@+id/lv_group"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:listSelector="@android:color/transparent"
                android:descendantFocusability="blocksDescendants"
                android:defaultFocusHighlightEnabled="false"
                android:paddingStart="16dp"
                android:paddingEnd="8dp" />

            <!-- 频道列表 -->
            <ListView
                android:id="@+id/lv_channel_list"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:listSelector="@android:color/transparent"
                android:descendantFocusability="blocksDescendants"
                android:defaultFocusHighlightEnabled="false"
                android:paddingStart="8dp"
                android:paddingEnd="16dp" />

            <!-- 节目单按钮 -->
            <TextView
                android:id="@+id/btn_show_epg"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="节\n目\n单"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <!-- 右侧面板 -->
        <LinearLayout
            android:id="@+id/ll_right_panel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@drawable/panel_bg"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <!-- 返回按钮 -->
            <TextView
                android:id="@+id/btn_back_group"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="频\n道\n组"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:paddingStart="16dp" />

            <!-- 右侧频道列表 -->
            <ListView
                android:id="@+id/lv_channel_list_epg"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:listSelector="@android:color/transparent"
                android:descendantFocusability="blocksDescendants"
                android:defaultFocusHighlightEnabled="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- 日期列表 -->
            <ListView
                android:id="@+id/lv_date"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:listSelector="@android:color/transparent"
                android:descendantFocusability="blocksDescendants"
                android:defaultFocusHighlightEnabled="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- EPG列表 -->
            <ListView
                android:id="@+id/lv_epg"
                android:layout_width="360dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:listSelector="@android:color/transparent"
                android:descendantFocusability="blocksDescendants"
                android:defaultFocusHighlightEnabled="false"
                android:paddingStart="8dp"
                android:paddingEnd="16dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部信息栏 -->
    <LinearLayout
        android:id="@+id/info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_gravity="bottom"
        android:background="@drawable/info_bar_gradient_bg"
        android:visibility="gone">
        <!-- ... 内部内容保持原样 ... -->
    </LinearLayout>

    <!-- 日志窗口 -->
    <FrameLayout
        android:id="@+id/log_window_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:visibility="gone">
        <ScrollView
            android:id="@+id/log_scroll_view"
            android:layout_width="340dp"
            android:layout_height="450dp"
            android:background="#B3000000"
            android:padding="12dp"
            android:scrollbars="none">
            <TextView
                android:id="@+id/tv_log_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:typeface="monospace"
                android:text="日志将在此显示..." />
        </ScrollView>
    </FrameLayout>

</FrameLayout>
