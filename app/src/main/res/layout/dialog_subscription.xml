<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#272B3A"
    android:padding="0dp">

    <!-- 顶部：标题 + 扫码远程输入 + 列表订阅 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="#1E2230">

        <!-- 新增：自定义标题 -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="直播源订阅"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 扫码远程输入区域 (移到标题下方) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_below="@id/tv_dialog_title"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="扫码远程输入"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_ip_address"
                android:text="http://192.168.1.2:9978/"
                android:textColor="#A0A0A0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 右上角列表订阅文字 (对齐标题右侧) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@id/tv_dialog_title"
            android:text="列表订阅"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 中间：二维码 + 列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">
        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="#FFFFFF"
            android:scaleType="fitCenter" />
        <ListView
            android:id="@+id/lv_source_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:divider="@null" />
    </LinearLayout>

    <!-- 底部：输入 + 操作按钮 + 关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#1E2230">
        <TextView
            android:text="1."
            android:textColor="#666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"/>
        <EditText
            android:id="@+id/et_name"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:hint="请输入名称(选填)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@null"
            android:padding="8dp"
            android:maxLines="1" />
        <TextView
            android:text="2."
            android:textColor="#666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"/>
        <EditText
            android:id="@+id/et_url"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:hint="请输入地址"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@null"
            android:padding="8dp"
            android:maxLines="1" />
        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🗑️"
            android:background="#55576A"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true"/>
        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="确定"
            android:textColor="#FFFFFF"
            android:backgroundTint="#40A9FF"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true"/>
        <Button
            android:id="@+id/btn_save_permission"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="存储权限"
            android:textColor="#FFFFFF"
            android:backgroundTint="#40A9FF"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true"/>
        
        <!-- 新增：自定义关闭按钮 -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="关闭"
            android:textColor="#FFFFFF"
            android:backgroundTint="#40A9FF"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true"/>
    </LinearLayout>
</LinearLayout>
