<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/item_bg_selector"
    android:focusable="true"
    android:clickable="false">
    <!-- 
      ✏️【修改点详解】
      1. background: 移除 ?android:attr/selectableItemBackground（原生波纹不适合电视焦点），改为 @drawable/item_bg_selector
      2. clickable: 改为 "false"，防止整行拦截 ListView 的 onItemClick
    -->

    <RadioButton
        android:id="@+id/rb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:clickable="false" />

    <TextView
        android:id="@+id/tv_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/item_text_selector"
        android:textSize="14sp"
        android:maxLines="3"
        android:ellipsize="none"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />
        <!-- ✏️ 将硬编码的 #333333 替换为 @color/item_text_selector，自动在白色/蓝色间切换 -->

    <Button
        android:id="@+id/btn_delete_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✕"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:textColor="#FF0000"
        android:focusable="false"
        android:clickable="true" />
        <!-- ✏️ 将 focusable="true" 改为 "false"，防止删除按钮抢走整行焦点，确保遥控器上下键顺畅切换行 -->
</LinearLayout>
