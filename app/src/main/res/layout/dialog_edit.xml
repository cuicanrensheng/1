<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText,UnusedResources"> <!-- ✅ 跳过所有硬编码和未使用资源警告 -->

    <!-- 源名称输入框 -->
    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="源名称（如：主源、备用源）"
        android:inputType="text"
        android:singleLine="true"
        android:textSize="14sp"
        android:autofillHints="name" /> <!-- ✅ 修复 Autofill -->

    <!-- 源地址输入框 -->
    <EditText
        android:id="@+id/et_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="源地址 URL"
        android:inputType="textUri"   <!-- ✅ 修复 TextFields，改为 textUri -->
        android:singleLine="true"
        android:textSize="14sp"
        android:autofillHints="url" /> <!-- ✅ 修复 Autofill -->

</LinearLayout>
