<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 触屏按下时（手机手指点按）：浅蓝色背景 -->
    <item android:state_pressed="true" android:drawable="@color/bg_highlight" />

    <!-- 2. 有焦点 + 选中（遥控器光标选中） -->
    <item android:state_focused="true" android:state_selected="true" android:drawable="@color/bg_highlight" />
    
    <!-- 3. 有焦点（遥控器光标悬停，未确认） -->
    <item android:state_focused="true" android:drawable="@color/bg_highlight" />
    
    <!-- 4. 无焦点 + 选中（点击或选中后，但光标不在上面时） -->
    <item android:state_selected="true" android:drawable="@color/bg_highlight" />
    
    <!-- 5. 默认未选中：改为和外框完全一样的深色背景 -->
    <item android:drawable="#CC121212" />
</selector>
