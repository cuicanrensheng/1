<?xml version="1.0" encoding="utf-8"?>

<!--
  Android 应用清单文件

  作用：声明应用的包名、权限、四大组件等

  修改历史：
  - 2026-06-21：新增 largeHeap，缓解 EPG 加载 OOM
  - 2026-06-22：MainActivity 添加画中画支持配置
                1. 新增 supportsPictureInPicture="true"
                2. configChanges 新增 screenLayout（共 4 项，缺一不可）
  - 2026-06-24：新增 tools:overrideLibrary 强制覆盖 Media3 各模块的 minSdk 限制
                原因：Media3 1.10.1 的多个模块都声明了 minSdk=23，
                但我们项目需要支持到 API 21（兼容低端电视），
                所以用 tools:overrideLibrary 强制跳过 Manifest 合并检查。
  - 2026-06-25：minSdk 升到 23，删除 tools:overrideLibrary
                原因：minSdk 已经和 Media3 要求的 23 一致，
                不需要再强制覆盖了，Manifest 合并可以正常通过。
  - 2026-06-25：改回 minSdk 21，重新加上 tools:overrideLibrary
                原因：需要兼容低端电视（Android 5.1 / API 22），
                所以把 minSdk 降回 21，重新加上强制覆盖。
                风险：Media3 1.10.1 内部可能使用了 API 23 才有的接口，
                在 Android 5.x 设备上可能运行时崩溃，需要实际测试验证。
-->

<!-- ==================================================================== -->
<!-- ✅ 2026-06-25 重新加上：tools 命名空间 -->
<!-- ==================================================================== -->
<!-- 【为什么加？】 -->
<!-- tools:overrideLibrary 需要 tools 命名空间支持。 -->
<!-- xmlns:tools 是 Android 开发工具专用的命名空间， -->
<!-- 用于在 Manifest 中给编译器/打包工具传递指令。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.tv.live">

    <!-- 网络相关权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 存储相关权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- 安装相关权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 开机自启权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 唤醒锁权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ==================================================================== -->
    <!-- ✅ 2026-06-25 重新加上：强制覆盖所有 Media3 模块的 minSdk 限制 -->
    <!-- ==================================================================== -->
    <!-- 【为什么加这个？】 -->
    <!-- Media3 1.10.1 的多个模块都在自己的 Manifest 里声明了 minSdk=23， -->
    <!-- 意思是「我这个库只用了 API 23 以上的接口，低于 23 的设备我不保证能跑」。 -->
    <!-- 我们项目把 minSdk 降到了 21，Manifest 合并的时候就会报错： -->
    <!-- "minSdk 版本 21 不能小于库中声明的版本 23" -->
    <!--  -->
    <!-- 【已经确认会报错的模块】 -->
    <!-- 1. androidx.media3.exoplayer.hls   - HLS 直播流支持 -->
    <!-- 2. androidx.media3.exoplayer.dash  - DASH 流支持 -->
    <!--  -->
    <!-- 【可能也会报错的模块（提前加上，避免反复编译）】 -->
    <!-- 3. androidx.media3.exoplayer       - 核心播放器 -->
    <!-- 4. androidx.media3.ui              - UI 组件（PlayerView） -->
    <!-- 5. androidx.media3.common          - 通用工具类 -->
    <!-- 6. androidx.media3.datasource      - 数据源模块 -->
    <!--  -->
    <!-- 【tools:overrideLibrary 的作用】 -->
    <!-- 告诉 Manifest 合并工具：「我知道这些库要求 minSdk 23， -->
    <!-- 但我硬要降到 21，出了问题我自己负责，你别报错了」。 -->
    <!-- 工具就会跳过这个检查，让合并通过。 -->
    <!--  -->
    <!-- 【风险提示】 -->
    <!-- ⚠️ 这只是跳过了编译时的检查，不代表库在 API 21 上一定能跑。 -->
    <!-- 这些模块内部可能真的使用了 API 23 才有的类或方法， -->
    <!-- 在 Android 5.0/5.1（API 21-22）设备上运行时可能会崩溃。 -->
    <!--  -->
    <!-- 【怎么办？】 -->
    <!-- 1. 先加上这个，让编译通过 -->
    <!-- 2. 拿到那台低端电视上实际测试能不能播 -->
    <!-- 3. 如果能播 → 完美，就这样用 -->
    <!-- 4. 如果崩了 → 再降级到 Media3 1.7.1（官方支持 minSdk 21 的最后一个版本） -->
    <!--  -->
    <!-- 【为什么放在这里？】 -->
    <!-- <uses-sdk> 标签必须在 <application> 标签之前， -->
    <!-- 这是 Android Manifest 的规范要求。 -->
    <uses-sdk
        tools:overrideLibrary="
            androidx.media3.exoplayer.hls,
            androidx.media3.exoplayer.dash,
            androidx.media3.exoplayer,
            androidx.media3.ui,
            androidx.media3.common,
            androidx.media3.datasource
        " />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TVLive.NoTitle"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- ============================================================ -->
        <!-- 主页面：直播播放页（MainActivity）                            -->
        <!-- ============================================================ -->
        <!--
          画中画配置说明：
          1. supportsPictureInPicture="true"
             作用：声明该 Activity 支持画中画模式
             注意：不加这个属性，调用 enterPictureInPictureMode() 会失败

          2. configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
             作用：配置变化时不重建 Activity，自己处理
             为什么必须 4 项？
             画中画模式变化时，系统会触发 4 种配置变化：
             a. orientation - 屏幕方向
             b. screenSize - 屏幕尺寸
             c. smallestScreenSize - 最小屏幕尺寸
             d. screenLayout - 屏幕布局（最容易漏掉的！）
             漏掉的后果：Activity 被销毁重建，导致
             1. 画中画进入/退出时黑屏
             2. 播放器重新初始化，播放中断
             3. 状态丢失（当前频道、播放进度等）
             4. 退出画中画后播放器还是小窗尺寸
             参考：TVBox 项目的画中画配置也是这 4 项
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页面 -->
        <activity
            android:name=".SettingsActivity"
            android:theme="@style/TransparentTheme"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize" />

        <!-- 频道列表页面 -->
        <activity
            android:name=".ChannelListActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize" />

        <!-- 崩溃页面 -->
        <activity
            android:name=".CrashActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- 开机自启广播接收器 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- 延迟启动执行器 -->
        <receiver
            android:name=".BootStartReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tv.live.START_APP" />
            </intent-filter>
        </receiver>

        <!-- FileProvider：文件共享提供者 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
